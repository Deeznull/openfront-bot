+/**
+ * Solo autoplay: the code bot plays each human (it spawns them and then
+ * attacks, builds and makes alliances on its own).
+ */
+export function autoplayExecutions(
+  gameStart: GameStartInfo,
+  humans: PlayerInfo[],
+): BotExecution[] {
+  if (
+    !gameStart.config.botAutoplay ||
+    gameStart.config.gameType !== GameType.Singleplayer
+  ) {
+    return [];
+  }
+  return humans.map(
+    (h) =>
+      new BotExecution(
+        `${gameStart.gameID}:${h.id}`,
+        new Nation(undefined, h),
+        AUTOPLAY_PARAMS,
+      ),
+  );
+}
